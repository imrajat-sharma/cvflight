# PostgreSQL; never expose this to the browser
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Canonical public origin (required for Stripe); use HTTPS in production
APP_ORIGIN=http://localhost:3000
# Set true on HTTPS deployments. Keep false for local HTTP development.
COOKIE_SECURE=false

# LaTeX never runs on the host. Build the Docker image before enabling.
LATEX_COMPILER_ENABLED=false
LATEX_DOCKER_IMAGE=cvflight-latex:local

# Optional managed AI subscriptions. All must be set to enable checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
MANAGED_AI_PROVIDER=mistral
MANAGED_AI_MODEL=mistral-small-latest
MANAGED_AI_API_KEY=

# Browser tests against an already running server
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
